# Entorno
DJANGO_SETTINGS_MODULE=global_exchange.settings.dev

# Seguridad
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos
DB_NAME_DEV=
DB_NAME_PROD=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Keycloak
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# Stripe (pago con tarjeta). Vacío en desarrollo: sin esto, iniciar un pago
# con tarjeta simplemente falla con el mismo mensaje de "no se pudo
# conectar con Stripe" que un corte de comunicación real (no hace falta
# una cuenta de Stripe para trabajar en el resto del sistema).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SIPAP (pago por transferencia bancaria y billeteras digitales). No existe
# un sandbox público de SIPAP, así que lo simula "sipap-sim" (ver
# sipap_sim/), un proyecto Django aparte que en desarrollo corre con
# "python manage.py runserver 8001" desde sipap_sim/. SIPAP_API_KEY y
# SIPAP_WEBHOOK_SECRET deben coincidir con los que tenga configurados ese
# proyecto (ver sipap_sim/sipap_sim/settings.py).
SIPAP_BASE_URL=http://localhost:8001
SIPAP_API_KEY=sipap-sim-api-key-de-desarrollo
SIPAP_WEBHOOK_SECRET=sipap-sim-webhook-secret-de-desarrollo