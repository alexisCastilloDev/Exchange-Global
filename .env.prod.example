# Variables de entorno para el entorno de "producción" académica en AWS.
# Copiar a .env en la raíz del repo (junto a manage.py) antes de levantar
# deploy/aws/docker-compose.yml. No commitear el .env real.

# Entorno
DJANGO_SETTINGS_MODULE=global_exchange.settings.prod

# Seguridad
SECRET_KEY=
DEBUG=False
# Dominio gratuito de DuckDNS apuntando a la Elastic IP de la instancia EC2.
DOMINIO=tu-subdominio.duckdns.org
ALLOWED_HOSTS=tu-subdominio.duckdns.org
CSRF_TRUSTED_ORIGINS=https://tu-subdominio.duckdns.org

# Base de datos (RDS PostgreSQL free tier). DB_NAME_PROD es la base de
# Django; Keycloak usa KEYCLOAK_DB_NAME, una base aparte en la misma
# instancia de RDS (no hace falta una segunda instancia).
DB_NAME_PROD=global_exchange
DB_USER=
DB_PASSWORD=
DB_HOST=tu-instancia.xxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
KEYCLOAK_DB_NAME=keycloak

# Keycloak — el valor que ve el navegador y el que usa Django para
# construir los endpoints OIDC son el mismo: la URL pública HTTPS,
# con el path /auth que configura el propio contenedor de Keycloak.
# La barra final es obligatoria: sin ella, python-keycloak descarta el
# "/auth" al armar las URLs de la Admin API (ver apps.users.services) y
# todo lo que pasa por ahí (asignar roles, sincronizar usuarios, etc.)
# falla con 404, aunque el login normal siga funcionando.
KEYCLOAK_SERVER_URL=https://tu-subdominio.duckdns.org/auth/
KEYCLOAK_REALM=global-exchange
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
